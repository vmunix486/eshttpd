#!/usr/bin/env bash

echo "Configure script for eshttpd"

###############################################
# Asking user if they want to remove Makefile #
###############################################

echo ""

read -rp "Do you already have a Makefile? [y/n] " makefile

if [ $makefile == y ]; then
	echo "Are you sure you want to continue?"
	echo "This will remove the existing Makefile."
	read -rp "[y/n] : " existmakefile

	while true; do
		case $existmakefile in
			[Yy]* ) echo "Removing Makefile..."; rm -f Makefile; break;;
			[Nn]* ) echo "Exiting..."; exit 1;;
			* ) echo "Yes or no."
		esac
	done
fi

echo ""

######################################
# Asking user what C compiler to use #
######################################

read -rp "What is the executable for your C compiler? " compiler

echo "# Makefile generated by configure" >> Makefile
echo "CC=$compiler" >> Makefile

echo ""

########################################
# Asking user for C compiler arguments #
########################################

echo "What do you want the flags to the compiler to be?"
echo "Use -std=c89 for compatibility!"
read -rp "Flags: " flags

echo "CFLAGS= $flags" >> Makefile

echo ""

#################################
# Ask user for eshttpd features #
#################################

echo "What features do you want enabled? Look in CONFIG.md for info."
read -rp "Definitions: " defines

echo "DEFS= $defines" >> Makefile

echo ""

#########################
# Doing last few things #
#########################

echo "That should be all. If this helped, consider leaving a star on GitHub."

echo "" >> Makefile
echo "all: eshttpd.c" >> Makefile
echo '	$(CC) $(CFLAGS) $(DEFS) eshttpd.c -o eshttpd' >> Makefile

echo "" >> Makefile

echo "test:" >> Makefile
echo "	sudo ./eshttpd" >> Makefile
echo "	curl -v localhost" >> Makefile
echo "	sudo killall eshttpd" >> Makefile

echo "" >> Makefile

echo "clean:" >> Makefile
echo "	rm -f eshttpd" >> Makefile

#######
# EOF #
#######
